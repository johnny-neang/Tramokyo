{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "^/survey$", "status": 308, "headers": { "Location": "/survey/" } },
    { "src": "^/survey/$", "dest": "/survey-site/index.html" },
    { "src": "^/survey/(.+)$", "dest": "/survey-site/$1" },
    { "src": "^/trubiki/?$", "dest": "/trubiki.html" }
  ]
}
