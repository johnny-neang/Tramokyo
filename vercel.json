{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/survey", "destination": "/survey/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/survey/", "destination": "/survey-site/index.html" },
    { "source": "/survey/:path+", "destination": "/survey-site/:path+" },
    { "source": "/trubiki", "destination": "/trubiki.html" },
    { "source": "/trubiki/", "destination": "/trubiki.html" },
    { "source": "/podcast", "destination": "/podcast.html" },
    { "source": "/podcast/", "destination": "/podcast.html" }
  ]
}
